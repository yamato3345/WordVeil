# Local development settings. Do not use these credentials in production.
HTTP_ADDR=:8080

jWT_SECRET=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Used by Go running on the host. Keep credentials and port in sync above.
# URL-encode special characters in credentials when changing this URL.
DATABASE_URL=

# Comma-separated exact origins. Empty uses local Vite and Tauri defaults.
# Set your frontend origin(s) explicitly in production.
CORS_ALLOWED_ORIGINS=
